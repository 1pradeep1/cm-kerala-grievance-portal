# Copy this file to .env (never commit .env) and fill in your own values.
# Neon connection string, e.g. postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL=
# Any long random string (32+ characters). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
PORT=4000
# Free Google AI Studio key (used from the AI step onward). If empty, the labelled fallback is used.
GEMINI_API_KEY=
# Model names change over time. Run `npm run ai:check` to list the models your key can use.
GEMINI_MODEL=gemini-flash-latest
# Comma-separated backups tried in order if the main model fails
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
